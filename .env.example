# --- Source database (PostgreSQL) ---
SOURCE_DB_USER=bank_user
SOURCE_DB_PASSWORD=change_me
SOURCE_DB_NAME=bank_source
SOURCE_DB_HOST=localhost
SOURCE_DB_HOST_PORT=5434
SEED_CUSTOMERS=1000

# --- Kafka and Debezium ---
KAFKA_HOST_PORT=29092
CONNECT_HOST_PORT=8083
KAFKA_UI_HOST_PORT=8085
DEBEZIUM_CONNECTOR_NAME=bank-source-connector
DEBEZIUM_TOPIC_PREFIX=bank
DEBEZIUM_SLOT_NAME=bank_slot
DEBEZIUM_PUBLICATION_NAME=bank_publication

# Phase 1 batch pipeline
AIRFLOW_HOST_PORT=8086
AIRFLOW_FERNET_KEY=
RAW_DIR=/opt/airflow/data/raw
REPORT_DIR=/opt/airflow/data/reports
RAW_SCHEMA=raw
STAGING_SCHEMA=staging
CURATED_SCHEMA=curated
SERVING_SCHEMA=serving
BATCH_ROWS=1200
SOURCE_SCHEMA=public
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local_course_only
