{
  "uid": "bank-jobs",
  "title": "Bank Pipeline Jobs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "External jobs by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "bank_jobs_total",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Continuous Spark active (1=yes)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "bank_realtime_active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Seconds since last completed microbatch",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "expr": "time() - bank_realtime_last_completed_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rows in last microbatch",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "expr": "bank_realtime_last_batch_rows",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
